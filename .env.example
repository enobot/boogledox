# Optional directory for the local PostgreSQL-compatible database.
# When unset, documents are stored in ~/.boogledox/pglite
# so OneDrive does not sync the live database files.
# BOOGLEDOX_DATA_DIR=

# Hosted mode. Leave these unset for local PGlite and the demo account switcher.
# In production, both values are required. The server refuses to start document
# requests without them, and it does not fall back to the local database.
# Copy the publishable key from the Supabase Connect dialog. Do not put a secret key here.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
